+static int
+iso6937_mbtowc (conv_t conv, ucs4_t *pwc, const unsigned char *s, size_t n)
+{
+  unsigned char c = *s;
+  if (c < 0xa0) {
+    *pwc = (ucs4_t) c;
+    return 1;
+  }
+  if (c >= 0xc1 && c <= 0xcf && c != 0xc9 && c != 0xcc) {
+    /* 组合音符前缀：必须消费第二字节；序列不完整按 RET_TOOFEW
+       等待，第二字节无对应组合按 RET_ILSEQ——与 glibc 一致 /
+       combining accent prefix: must consume a second byte;
+       incomplete sequence waits via RET_TOOFEW, a second byte
+       with no composition is RET_ILSEQ — same as glibc */
+    unsigned char c2;
+    if (n < 2)
+      return RET_TOOFEW(0);
+    c2 = s[1];
+    if (c2 < 0x20 || c2 > 0x7f)
+      return RET_ILSEQ;
+    {
+      unsigned short wc = iso6937_composed[c - 0xc0][c2 - 0x20];
+      if (wc == 0)
+        return RET_ILSEQ;
+      *pwc = (ucs4_t) wc;
+      return 2;
+    }
+  }
+  {
+    unsigned short wc = iso6937_2uni[c - 0xa0];
+    if (wc == 0)
+      return RET_ILSEQ;
+    *pwc = (ucs4_t) wc;
+    return 1;
+  }
+}
