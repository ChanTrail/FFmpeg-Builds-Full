+static int
+iso6937_wctomb (conv_t conv, unsigned char *r, ucs4_t wc, size_t n)
+{
+  if (wc < 0x00a0) {
+    *r = wc;
+    return 1;
+  }
+  {
+    size_t i;
+    for (i = 0; i < sizeof(iso6937_rev_single)/sizeof(iso6937_rev_single[0]); i++)
+      if (iso6937_rev_single[i][0] == wc) {
+        *r = (unsigned char) iso6937_rev_single[i][1];
+        return 1;
+      }
+    for (i = 0; i < sizeof(iso6937_rev_composed)/sizeof(iso6937_rev_composed[0]); i++)
+      if (iso6937_rev_composed[i][0] == wc) {
+        if (n < 2)
+          return RET_TOOSMALL;
+        r[0] = (unsigned char) iso6937_rev_composed[i][1];
+        r[1] = (unsigned char) iso6937_rev_composed[i][2];
+        return 2;
+      }
+  }
+  return RET_ILUNI;
